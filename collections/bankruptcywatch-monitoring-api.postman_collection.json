  "info": {
    "_postman_id": "ba6666d4-6ec7-46b7-b9c3-a7b1e97ba48e",
    "name": "BankruptcyWatch PACER Cases Monitoring API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The BankruptcyWatch PACER API provides a comprehensive suite of services for interacting with United States Bankruptcy Court data via PACER (Public Access to Court Electronic Records). The API enables creditors, lenders, and legal teams to search for bankruptcy cases, retrieve case details, file documents, monitor case activity, and automate bankruptcy workflows including Proof of Claim filing and loan restructuring.",
      "type": "text/plain"
    }
  }
